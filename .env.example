# ============================================================
#  audit-agent 配置模板
#
#  用法：复制本项目录下的 .env.example 为 .env，然后填写。
#        .env 已在 .gitignore 里，不会被提交 —— 别把 key 提交上去。
#
#  优先级：命令行环境变量 > .env > 代码默认值
# ============================================================

# ------------------------------------------------------------
# 数据库
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root

# ------------------------------------------------------------
# LLM（可选）
#
# 不填 key 项目也能完整运行，审核走「规则引擎 + 人工复核」。
# 填了之后，命中 REVIEW 级规则的灰区商品会先交给模型判断。
#
# LLM_MODE:
#   live  = 真调模型（需要下面的 LLM_API_KEY）
#   mock  = 用脚本化假响应驱动同一套循环代码，不需要 key
#           用途是验证工具调用/消息拼装/终止条件这条路径
# ------------------------------------------------------------
LLM_MODE=live

# ---------- 方案 A：DeepSeek 官方（推荐，便宜）----------
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- 方案 B：硅基流动（国内直连，注册送额度）----------
# LLM_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3

# ---------- 方案 C：通义千问 DashScope（OpenAI 兼容模式）----------
# LLM_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ---------- 方案 D：智谱 GLM ----------
# LLM_API_KEY=xxxxxxxx.xxxxxxxx
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# 单次请求超时（秒）。长视频/长文本审核可以调大
LLM_TIMEOUT=60

# ------------------------------------------------------------
# 审核阈值
# ------------------------------------------------------------
# 自动通过门槛：规则无命中 + 卖家信用 >= 此值 + 无未处理举报
AUTO_APPROVE_MIN_CREDIT=70
# 模型置信度低于此值转人工复核
REVIEW_THRESHOLD=0.75

# ------------------------------------------------------------
# 任务与重试
# ------------------------------------------------------------
# worker 被 kill 后任务会卡在 running，超过这个分钟数就回收
JOB_LOCK_TIMEOUT_MIN=10
# 单个任务最多被领取几次
MAX_ATTEMPTS=3
# 每处理多少个任务检查一次僵尸任务
RECLAIM_EVERY=50

# ------------------------------------------------------------
# 并发
# ------------------------------------------------------------
# 单个 worker 进程内并发处理的任务数。
# 任务是 IO 密集型（等模型 HTTP 响应），线程池就够用。
# 实测（200 件样本）：并发 1 = 76.9s，8 = 10.9s，16 = 6.9s（11.2 倍加速，P95 无恶化）
# 默认 8；调大到 16 可以更快，注意别把模型服务的限流打满。
WORKER_CONCURRENCY=8

# LLM 调用失败的重试次数（只对 429/5xx/网络错误重试）
LLM_MAX_RETRIES=3

# mock 模式下每轮"模型响应"的模拟延迟（秒），用于可复现的并发压测
MOCK_LLM_DELAY=0

# ------------------------------------------------------------
# 日志
# ------------------------------------------------------------
# text = 本地开发，人类可读；json = 生产，一行一个 JSON，便于日志系统采集
LOG_FORMAT=text
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------
# LLM 限流与成本护栏
# ------------------------------------------------------------
# 每分钟允许的 LLM 调用数；0 表示不限速
LLM_RATE_PER_MIN=60
# 令牌桶容量（允许的瞬时突发），默认等于一分钟的量
LLM_RATE_BURST=60
# 取不到令牌时最多等多久（秒），等不到就降级为「只走规则」
LLM_RATE_WAIT_MAX=20

# 单价（每 100 万 token）—— **按你实际用的服务商官网价格填写**，下面是占位默认值
LLM_PRICE_INPUT_PER_M=2.0
LLM_PRICE_OUTPUT_PER_M=8.0
LLM_PRICE_CURRENCY=CNY

# 日预算上限；0 表示不限。注意预算是**软约束**：
# 花费要等调用返回才知道，并发 N 路时最多超出 N × 单次最大成本，建议留安全余量
LLM_DAILY_BUDGET=10.0
# 日调用次数上限（**硬上限**，取令牌时预扣）；0 表示不限
LLM_DAILY_CALL_LIMIT=2000
# 护栏总开关；mock 模式会自动跳过（否则会扭曲并发压测）
LLM_GUARD_ENABLED=1

# ------------------------------------------------------------
# 调查预算（Agent 层的成本控制）
# ------------------------------------------------------------
# 每个商品最多允许调用几次工具（submit_verdict 不计入）。0 = 不限。
#
# 不加限制时，模型会把 5 个查询工具全调一遍（实测 84% 的任务工具组合完全相同），
# 而 prompt 里其实已经给出了规则命中/信用分/举报数，等于重复取数。
#
# 实测（200 件样本）：
#   不限 -> 1.81 次/任务，复核率 27.0%
#   1    -> 1.30 次/任务，复核率 28.5%
#   2    -> 1.57 次/任务，复核率 27.5%
#   3    -> 1.73 次/任务，复核率 27.0%，token 比旧版降 50%
# 各档位召回率均为 100%、误杀率均为 0%，说明预算没有牺牲检出能力。
LLM_TOOL_BUDGET=3
